# Multi-Domain Production Configuration
# sodaneh.ir -> Landing & Blog
# app.sodaneh.ir -> Customer Shopping App
# dashboard.sodaneh.ir -> Admin Dashboard
# api.sodaneh.ir -> Backend API & Uploads

NEXT_PUBLIC_API_URL=https://api.sodaneh.ir/api/v1
NEXT_PUBLIC_APP_NAME="سودانه | Sodaneh"
NEXT_PUBLIC_APP_URL=https://app.sodaneh.ir
NEXT_PUBLIC_SITE_URL=https://sodaneh.ir
LANDING_DOMAIN=sodaneh.ir
APP_DOMAIN=app.sodaneh.ir

# Optional server-only address when the core runs on another host.
CORE_API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
