# Production API configuration for sodaneh.ir. Fill private values on the server only.
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
STORE_CURRENCY=IRT
CORS_ORIGIN=https://sodaneh.ir,https://www.sodaneh.ir,https://app.sodaneh.ir,https://dashboard.sodaneh.ir
PUBLIC_API_ORIGIN=https://api.sodaneh.ir
PAYMENT_RESULT_URL=https://app.sodaneh.ir/orders
# Actual local reverse proxy only. Bind/block direct API access at deployment.
TRUSTED_PROXIES=127.0.0.1,::1
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ORDER_PAYMENT_SECRET=
ORDER_TRACKING_SECRET=
ADMIN_DEFAULT_EMAIL=
ADMIN_INITIAL_PASSWORD=
PAYMENT_MOCK_ENABLED=false
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=
FEATURE_SMS_AUTH=false
SMS_MOCK_ENABLED=false
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
ALLOW_DESTRUCTIVE_DEMO_SEED=false
